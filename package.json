        "zod": "^3"
    },
    "peerDependencies": {
        "@hookform/resolvers": "^3",
        "react": "^18 || ^19",
        "react-hook-form": "^7",
        "zod": "^3"
    },
    "dependencies": {
        "@hookform/resolvers": "^3",
        "react-hook-form": "^7"
    }
